generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SUPER_ADMIN
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  phone           String?
  passwordHash    String
  role            Role     @default(STUDENT)
  image           String?
  /// ACTIVE = can log in, SUSPENDED = blocked from logging in
  status          String   @default("ACTIVE")
  notifyOnMessage Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentProfile   StudentProfile?
  instructorProfile InstructorProfile?

  // Course management (instructor)
  courses          Course[]

  // Student enrollments
  enrollments      Enrollment[]

  // Payments
  payments         Payment[]

  // Submissions
  submissions      Submission[]

  // Attendance records
  attendanceRecords AttendanceRecord[]

  // Attendance sessions (instructor)
  attendanceSessions AttendanceSession[]

  // Bundle assignments (student)
  bundleAssignments  BundleAssignment[]

  // Bundles created (instructor)
  bundles            Bundle[]

  // Password resets
  passwordResets     PasswordReset[]

  // Direct messages
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")

  @@index([role])
  @@index([email, role])
  @@map("users")
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio       String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_profiles")
}

model InstructorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String?
  bio         String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("instructor_profiles")
}

model Course {
  id          String    @id @default(cuid())
  title       String
  description String?
  /// Bullet-pointed "what's included" / "what you'll learn" list shown on the
  /// course detail page. Stored as a Postgres text array; one entry per bullet.
  highlights  String[]  @default([])
  price       Float     @default(0)
  currency    String    @default("GHS")
  status      String    @default("ACTIVE")
  startDate   DateTime?
  endDate     DateTime?
  duration    String?
  image       String?
  instructorId String
  instructor   User      @relation(fields: [instructorId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  weeklyTopics  WeeklyTopic[]
  resources     Resource[]
  assessments   Assessment[]
  enrollments   Enrollment[]
  attendanceSessions AttendanceSession[]

  @@index([instructorId])
  @@index([status])
  @@index([instructorId, status])
  @@index([createdAt])
  @@map("courses")
}

model WeeklyTopic {
  id          String    @id @default(cuid())
  courseId     String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weekNumber  Int
  title       String
  description String?
  objectives  String?
  date        DateTime?
  // Instructor-driven milestone tracking: the instructor marks a topic as
  // covered for the whole course, and students see it as completed progress.
  covered     Boolean   @default(false)
  coveredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resources    Resource[]
  assessments  Assessment[]

  @@index([courseId])
  @@map("weekly_topics")
}

model Resource {
  id          String   @id @default(cuid())
  courseId     String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weeklyTopicId String?
  weeklyTopic  WeeklyTopic? @relation(fields: [weeklyTopicId], references: [id], onDelete: Cascade)
  title       String
  type        String
  url         String
  createdAt   DateTime @default(now())

  @@map("resources")
}

model Assessment {
  id           String    @id @default(cuid())
  courseId      String
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  weeklyTopicId String?
  weeklyTopic  WeeklyTopic? @relation(fields: [weeklyTopicId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  dueDate      DateTime?
  totalMarks   Float     @default(0)
  type         String    @default("QUIZ")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  questions    Question[]
  submissions  Submission[]

  @@index([courseId])
  @@index([courseId, dueDate])
  @@index([weeklyTopicId])
  @@map("assessments")
}

model Question {
  id           String   @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  text         String
  type         String
  options      Json?
  correctAnswer String?
  marks        Float    @default(1)
  createdAt    DateTime @default(now())

  answers      Answer[]

  @@map("questions")
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payment   Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

model Payment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  enrollmentId    String?  @unique
  enrollment      Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount          Float
  currency        String   @default("GHS")
  reference       String   @unique
  status          String   @default("PENDING")
  paystackRef     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([courseId])
  @@index([userId, status])
  @@map("payments")
}

model Submission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  status       String    @default("SUBMITTED")
  score        Float?
  feedback     String?
  komodoUrl    String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?

  answers      Answer[]

  @@index([userId])
  @@index([assessmentId])
  @@index([userId, assessmentId])
  @@map("submissions")
}

model Answer {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text         String?
  createdAt    DateTime @default(now())

  @@map("answers")
}

model AttendanceSession {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date        DateTime
  instructorId String
  instructor  User     @relation(fields: [instructorId], references: [id])
  createdAt   DateTime @default(now())

  records     AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  sessionId   String
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("PRESENT")
  createdAt   DateTime @default(now())

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([userId, status])
  @@index([sessionId])
  @@map("attendance_records")
}

model Bundle {
  id          String    @id @default(cuid())
  name        String
  description String?
  instructorId String
  instructor  User      @relation(fields: [instructorId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("ACTIVE")
  /// Minimum number of "PRESENT" or "LATE" attendance sessions a student must
  /// have across the instructor's courses to be eligible for this bundle.
  requiredAttendanceCount Int @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  requirements    BundleRequirement[]
  assignments     BundleAssignment[]

  @@map("bundles")
}

model BundleRequirement {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  title       String
  description String?
  isRequired  Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("bundle_requirements")
}

model BundleAssignment {
  id          String   @id @default(cuid())
  bundleId    String
  bundle      Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String   @default("ASSIGNED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([bundleId, userId])
  @@map("bundle_assignments")
}

/// A direct message between two users. Broadcasts and bulk sends are fanned out
/// to one row per recipient sharing a `broadcastId`, so read state stays
/// per-recipient and thread queries remain a simple two-party lookup.
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  broadcastId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, senderId, createdAt])
  @@index([senderId, recipientId, createdAt])
  @@index([broadcastId])
  @@map("messages")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("password_resets")
}
